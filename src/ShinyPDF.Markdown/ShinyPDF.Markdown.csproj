<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Authors>LM Development</Authors>
        <Company>LM IT Services AG</Company>
        <PackageId>ShinyPDF.Markdown</PackageId>
        <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
        <PackageDescription>Markdown rendering for ShinyPDF: turn Markdown text into PDF content with a single fluent call, laid out by the ShinyPDF engine.</PackageDescription>
        <PackageIcon>Logo.png</PackageIcon>
        <RepositoryUrl>https://github.com/LM-Development/ShinyPDF.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>LM IT Services AG, ShinyPDF contributors</Copyright>
        <PackageTags>pdf markdown report export generate generation render shiny shinypdf</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReleaseNotes Condition="'$(PackageReleaseNotesFile)' != '' and Exists('$(PackageReleaseNotesFile)')">$([System.IO.File]::ReadAllText('$(PackageReleaseNotesFile)'))</PackageReleaseNotes>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Markdig" Version="1.4.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ShinyPDF\ShinyPDF.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ShinyPDF.UnitTests" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\ShinyPDF\Resources\Logo.png" Pack="true" PackagePath="\" />
      <None Include="PackageReadme.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
